# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # Project URL (Supabase → Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon/publishable key (safe in browser)
SUPABASE_SERVICE_ROLE_KEY=           # Server-only secret — never expose to client
SUPABASE_DB_PASSWORD=                # Postgres password (server/CLI only)

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=                          # Bearer for /api/cron/* (Vercel Cron), including /api/cron/whoop

# ── WHOOP Connect (server-only — never NEXT_PUBLIC_) ──────
WHOOP_CLIENT_ID=                      # Developer Dashboard → the forum app
WHOOP_CLIENT_SECRET=                  # Same app. Also the webhook HMAC key unless WHOOP_WEBHOOK_SECRET is set
WHOOP_REDIRECT_URI=https://eoshadowforum.com/api/whoop/callback
# WHOOP signs webhooks with the app client secret. Set this only if the dashboard
# shows a webhook secret that is different from WHOOP_CLIENT_SECRET.
WHOOP_WEBHOOK_SECRET=
# 32-byte key, base64. Generate: openssl rand -base64 32
# Access and refresh tokens are AES-256-GCM ciphertext in whoop_connections.
WHOOP_TOKEN_ENCRYPTION_KEY=
# Auth user uuids (profiles.id), comma-separated, whose whoop_days are filled by
# an external sync and must not be overwritten. Put Dave Hajdu's user id here.
WHOOP_EXTERNAL_SYNC_USER_IDS=
SIGNUP_ACCESS_CODE=                    # Required to create an account (server-verified)

# ── AI / integrations ─────────────────────────────────────
GEMINI_API_KEY=                      # Google Gemini (image gen)
ANTHROPIC_API_KEY=                    # Claude API — powers the WHOOP data assistant
RESEND_API_KEY=                      # Resend (transactional email)
ADMIN_EMAILS=                        # Comma-separated admin allowlist
EMAIL_FROM=                          # Default from-address
