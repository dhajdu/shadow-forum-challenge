// Copy to Secrets.xcconfig (gitignored) and fill in from Supabase → Settings → API.
// Only the public anon key belongs here — NEVER the service-role key.
SF_SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SF_SUPABASE_ANON_KEY = your-anon-key

// Optional: point the app at a local web server (next dev) instead of production.
// SF_API_BASE_URL = http:/$()/localhost:3000
