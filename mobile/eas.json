{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://eoshadowforum.com"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6840256415",
        "appleTeamId": "MYBR59DBU2",
        "ascApiKeyPath": "./asc-api-key.p8",
        "ascApiKeyIssuerId": "c687b774-0d99-45b8-9739-3cb07ace976c",
        "ascApiKeyId": "4H7J57K76X"
      }
    }
  }
}
